# ONYX Configuration Environment Variables
ONYX_ENV=development
ONYX_PORT=8080
ONYX_HOST=127.0.0.1
ONYX_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ONYX_DATA_DIR=./data
ONYX_PROFILE=local-mac

# Memory Store (sqlite | postgres)
ONYX_MEMORY_BACKEND=sqlite
# If using postgres:
# ONYX_PG_URL=postgresql://onyx:onyx_secure_pass@localhost:5432/onyx_memory

# Model Backend Default (ollama | llamacpp | transformers | mock)
ONYX_DEFAULT_MODEL_BACKEND=mock
ONYX_OLLAMA_BASE_URL=http://localhost:11434
ONYX_LLAMACPP_MODEL_PATH=

# Security
ONYX_REQUIRE_AUTH=false
ONYX_AUTH_TOKEN=
